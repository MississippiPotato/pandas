{
  "name": "nba-datalab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/engine/*.test.js tests/integration/*.test.js",
    "test:pandas": "node scripts/verify-pandas.mjs",
    "data:prepare": "node scripts/prepare-nba.mjs",
    "data:validate": "node scripts/validate-nba.mjs",
    "check": "npm run test && npm run data:validate && npm run build"
  },
  "dependencies": {
    "d3": "7.9.0",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
